# Copy this file to .env and replace both values before running Docker Compose.
SSH_PORT=2222
# Host que aparecerá en el comando SCP asistido (dominio o IP pública).
AGORA_PUBLIC_HOST=localhost
SSH_PASSWORD=replace-with-a-long-random-secret
DB_PASSWORD=replace-with-a-different-long-random-secret
LANG=es

# open: cualquiera puede registrarse; invite: exige código; closed: solo login.
REGISTRATION_MODE=invite
